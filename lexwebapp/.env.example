# SecondLayer Web App - Environment Configuration
# Copy this file to .env.local and fill in your actual values
# These variables are injected at BUILD time by Vite (prefix: VITE_)

# =============================================================================
# API Connection (required)
# =============================================================================
# Backend API URL
VITE_API_URL=http://localhost:3000/api

# API authentication key (must match SECONDARY_LAYER_KEYS in backend)
VITE_API_KEY=your-api-key-here

# =============================================================================
# Feature Flags (optional)
# =============================================================================
# Enable Server-Sent Events streaming for long-running operations
VITE_ENABLE_SSE_STREAMING=true

# Mock payment processing (for development without real payment gateway)
VITE_MOCK_PAYMENTS=true
