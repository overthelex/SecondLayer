{
  "name": "rlhf-signals",
  "version": "0.1.0",
  "description": "RLHF preference signal collection from recursive founder workflows",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "rlhf:migrate": "tsx scripts/run-migrations.ts",
    "rlhf:retro": "tsx scripts/extract-retro.ts",
    "rlhf:attribute": "tsx scripts/attribute-outcomes.ts",
    "rlhf:feasibility": "tsx scripts/generate-feasibility.ts",
    "rlhf:classify": "tsx scripts/classify-edits.ts",
    "rlhf:link": "tsx scripts/link-transcripts.ts",
    "rlhf:ingest": "tsx src/capture/manual-ingest.ts",
    "rlhf:outcome": "tsx src/attribution/manual-outcomes.ts",
    "rlhf:redact": "tsx src/redaction/content-redactor.ts",
    "rlhf:export": "tsx src/export/dataset-builder.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ --ext .ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1045.0",
    "@octokit/graphql": "^8.2.1",
    "chokidar": "^4.0.3",
    "dotenv": "^16.4.7",
    "js-levenshtein": "^1.1.6",
    "pg": "^8.13.1",
    "winston": "^3.17.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/js-levenshtein": "^1.1.3",
    "@types/node": "^20.17.12",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.2",
    "typescript": "~5.3.3",
    "vitest": "^3.0.4"
  }
}
