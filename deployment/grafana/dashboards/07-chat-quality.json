          "steps": 64
        },
        "yAxis": {
          "unit": "short"
        },
        "tooltip": {
          "mode": "single",
          "yHistogram": true
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "sum(rate(chat_tool_repeat_max_bucket[5m])) by (le)",
          "format": "heatmap",
          "refId": "A",
          "legendFormat": "{{le}}"
        }
      ],
      "id": 10
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
