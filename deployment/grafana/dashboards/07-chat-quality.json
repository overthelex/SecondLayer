      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "sum(rate(chat_grounding_signals_total[5m])) by (signal_type) * 60",
          "refId": "A",
          "legendFormat": "{{signal_type}}"
        }
      ],
      "id": 4
    },
