{
  "Comment": "Orchestrate distributed court decision scraping pipeline. Optional — the pipeline works with just shell scripts (01-04). This SF automates the monitor+teardown loop.",
  "StartAt": "CheckQueueReady",
  "States": {
    "CheckQueueReady": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:sqs:getQueueAttributes",
      "Parameters": {
        "QueueUrl.$": "$.queueUrl",
        "AttributeNames": ["ApproximateNumberOfMessages"]
      },
      "ResultPath": "$.queueStatus",
      "Next": "IsQueuePopulated"
    },
    "IsQueuePopulated": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.queueStatus.Attributes.ApproximateNumberOfMessages",
          "StringEquals": "0",
          "Next": "QueueEmpty"
        }
      ],
      "Default": "WaitForDownload"
    },
    "QueueEmpty": {
      "Type": "Fail",
      "Error": "QueueEmpty",
      "Cause": "SQS queue is empty. Run enqueue script first."
    },
    "WaitForDownload": {
      "Type": "Wait",
      "Seconds": 300,
      "Next": "CheckProgress"
    },
    "CheckProgress": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:sqs:getQueueAttributes",
      "Parameters": {
        "QueueUrl.$": "$.queueUrl",
        "AttributeNames": [
          "ApproximateNumberOfMessages",
          "ApproximateNumberOfMessagesNotVisible"
        ]
      },
      "ResultPath": "$.progress",
      "Next": "IsComplete"
    },
    "IsComplete": {
      "Type": "Choice",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.progress.Attributes.ApproximateNumberOfMessages",
              "StringEquals": "0"
            },
            {
              "Variable": "$.progress.Attributes.ApproximateNumberOfMessagesNotVisible",
              "StringEquals": "0"
            }
          ],
          "Next": "ScaleDownWorkers"
        }
      ],
      "Default": "WaitForDownload"
    },
    "ScaleDownWorkers": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:autoscaling:updateAutoScalingGroup",
      "Parameters": {
        "AutoScalingGroupName": "secondlayer-bulk-scrape-asg",
        "MinSize": 0,
        "MaxSize": 0,
        "DesiredCapacity": 0
      },
      "ResultPath": "$.scaleDown",
      "Next": "WaitForTermination"
    },
    "WaitForTermination": {
      "Type": "Wait",
      "Seconds": 120,
      "Next": "Done"
    },
    "Done": {
      "Type": "Succeed"
    }
  }
}
