{
  "name": "secondlayer",
  "version": "1.0.0",
  "description": "Legal documents analysis platform with MCP server and admin panel",
  "private": true,
  "workspaces": [
    "mcp_backend",
    "mcp_rada",
    "mcp_openreyestr",
    "lexwebapp",
    "packages/shared"
  ],
  "scripts": {
    "backend": "cd mcp_backend && npm run dev:http",
    "frontend": "cd lexwebapp && npm run dev",
    "backend:build": "cd mcp_backend && npm run build",
    "frontend:build": "cd lexwebapp && npm run build",
    "install:all": "npm install",
    "batch-process": "tsx scripts/batch-process-documents.ts"
  },
  "keywords": [
    "mcp",
    "legal",
    "admin-panel",
    "zakononline"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.1",
    "@types/node": "^25.3.3",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.3",
    "commander": "^14.0.3",
    "dotenv": "^17.3.1",
    "fast-xml-parser": "^5.4.2",
    "jest-validate": "^30.2.0",
    "jest-watcher": "^30.2.0",
    "ora": "^9.3.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.7.0"
  },
  "overrides": {
    "postcss": "^8.4.49",
    "esbuild": ">=0.25.0",
    "minio": {
      "fast-xml-parser": ">=5.3.8"
    },
    "ajv": ">=8.18.0",
    "minimatch": ">=10.2.1",
    "hono": ">=4.12.4",
    "@hono/node-server": ">=1.19.10",
    "underscore": ">=1.13.8"
  },
  "dependencies": {
    "@withgraphite/graphite-cli": "^1.7.20"
  }
}
