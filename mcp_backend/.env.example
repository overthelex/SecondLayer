# SecondLayer MCP Backend - Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# PostgreSQL Database
# =============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=secondlayer
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=secondlayer

# Superuser (used only during DB initialization)
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=your_superuser_password

# =============================================================================
# Application
# =============================================================================
NODE_ENV=development
HTTP_PORT=3000
HTTP_HOST=0.0.0.0
LOG_LEVEL=debug

# JWT Secret (MUST change in production)
JWT_SECRET=change-this-in-production

# =============================================================================
# AI / LLM Configuration
# =============================================================================
# OpenAI — get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_API_KEY2=                           # Optional fallback key

# Embedding model
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Model selection by complexity tier
OPENAI_MODEL_QUICK=gpt-4o-mini
OPENAI_MODEL_STANDARD=gpt-4o-mini
OPENAI_MODEL_DEEP=gpt-4o

# Anthropic (optional)
ANTHROPIC_API_KEY=

# VoyageAI (optional, for alternative embeddings)
VOYAGEAI_API_KEY=
VOYAGEAI_API_KEY_2=
VOYAGEAI_EMBEDDING_MODEL=voyage-law-2

# LLM provider strategy: openai-first | anthropic-first
LLM_PROVIDER_STRATEGY=openai-first

# =============================================================================
# Security & Authentication
# =============================================================================
# API keys for SecondLayer services (comma-separated)
SECONDARY_LAYER_KEYS=your-api-key-1,your-api-key-2

# Google OAuth (optional) — https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# =============================================================================
# WebAuthn / Passkeys (optional)
# =============================================================================
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=SecondLayer
WEBAUTHN_ORIGIN=http://localhost:3000

# =============================================================================
# CORS & Frontend
# =============================================================================
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
APP_URL=http://localhost:3000
PUBLIC_URL=http://localhost:3000

# =============================================================================
# Redis
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379

# =============================================================================
# Qdrant Vector Database
# =============================================================================
QDRANT_URL=http://localhost:6333

# =============================================================================
# MinIO Object Storage
# =============================================================================
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_PUBLIC_URL=http://localhost:9000

# =============================================================================
# RADA MCP Integration
# =============================================================================
RADA_MCP_URL=http://localhost:3001
RADA_API_KEY=your-rada-api-key
RADA_API_KEYS=your-rada-api-key
RADA_POSTGRES_USER=rada_mcp
RADA_POSTGRES_PASSWORD=rada_password
RADA_POSTGRES_SCHEMA=rada

# =============================================================================
# OpenReyestr Integration
# =============================================================================
OPENREYESTR_MCP_URL=http://localhost:3005
OPENREYESTR_API_KEY=your-openreyestr-key
OPENREYESTR_API_KEYS=your-openreyestr-key
OPENREYESTR_POSTGRES_USER=openreyestr
OPENREYESTR_POSTGRES_PASSWORD=openreyestr_password
OPENREYESTR_POSTGRES_DB=openreyestr

# =============================================================================
# Google Cloud Vision API (for OCR, optional)
# =============================================================================
VISION_CREDENTIALS_PATH=/path/to/vision-ocr-credentials.json
GOOGLE_APPLICATION_CREDENTIALS=/path/to/vision-ocr-credentials.json

# =============================================================================
# Payment Gateways (optional)
# =============================================================================
# Monobank Acquiring — https://api.monobank.ua/docs/acquiring.html
MONOBANK_API_KEY=your_monobank_token

# NOWPayments (crypto) — https://nowpayments.io/
NOWPAYMENTS_API_KEY=your_nowpayments_key
NOWPAYMENTS_IPN_SECRET=your_ipn_secret

# =============================================================================
# Email (optional)
# =============================================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=SecondLayer

# =============================================================================
# DIIA Digital Signature (optional, Ukraine-specific)
# =============================================================================
DIIA_BASE_URL=https://api2.diia.gov.ua
DIIA_ACQUIRER_TOKEN=
DIIA_AUTH_ACQUIRER_TOKEN=
DIIA_BRANCH_ID=
DIIA_OFFER_ID=

# =============================================================================
# SneakyPiper OSINT Proxy
# =============================================================================
SNEAKYPIPER_API_URL=https://sneakypiper.com
SNEAKYPIPER_API_KEY=

# =============================================================================
# Feature Flags
# =============================================================================
ENABLE_UNIFIED_GATEWAY=false
