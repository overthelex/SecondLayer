<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://legal.org.ua/ontology/oversight"
         xmlns="http://legal.org.ua/ontology/oversight#">

<owl:Ontology rdf:about="http://legal.org.ua/ontology/oversight"/>

<owl:ObjectProperty rdf:about="#operatesOn">
  <rdfs:domain rdf:resource="#Agent"/>
  <rdfs:range rdf:resource="#State"/>
  <owl:inverseOf rdf:resource="#isOperatedOnBy"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#isOperatedOnBy">
  <rdfs:domain rdf:resource="#State"/>
  <rdfs:range rdf:resource="#Agent"/>
  <owl:inverseOf rdf:resource="#operatesOn"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#accessesState">
  <rdfs:domain rdf:resource="#Human"/>
  <rdfs:range rdf:resource="#State"/>
  <owl:inverseOf rdf:resource="#isAccessedBy"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#isAccessedBy">
  <rdfs:domain rdf:resource="#State"/>
  <rdfs:range rdf:resource="#Human"/>
  <owl:inverseOf rdf:resource="#accessesState"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#producesArtifact">
  <rdfs:domain rdf:resource="#Session"/>
  <rdfs:range rdf:resource="#Artifact"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasEdit">
  <rdfs:domain rdf:resource="#Artifact"/>
  <rdfs:range rdf:resource="#Edit"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasOutcome">
  <rdfs:domain rdf:resource="#Session"/>
  <rdfs:range rdf:resource="#Outcome"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#dependsOn">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <rdfs:domain rdf:resource="#Session"/>
  <rdfs:range rdf:resource="#Session"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#basedOn">
  <rdfs:domain rdf:resource="#Edit"/>
  <rdfs:range rdf:resource="#Information"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#accessibleTo">
  <rdfs:domain rdf:resource="#Information"/>
  <rdfs:range rdf:resource="#Agent"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasCriterion">
  <rdfs:domain rdf:resource="#Session"/>
  <rdfs:range rdf:resource="#SuccessCriterion"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#measuredBy">
  <rdfs:domain rdf:resource="#SuccessCriterion"/>
  <rdfs:range rdf:resource="#ProductionMetric"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasConsequence">
  <rdfs:domain rdf:resource="#Outcome"/>
  <rdfs:range rdf:resource="#ProductionMetric"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#partOf">
  <rdfs:domain rdf:resource="#Session"/>
  <rdfs:range rdf:resource="#Workflow"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasSession">
  <rdfs:domain rdf:resource="#Workflow"/>
  <rdfs:range rdf:resource="#Session"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasState">
  <rdfs:domain rdf:resource="#Session"/>
  <rdfs:range rdf:resource="#State"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasArtifact">
  <rdfs:domain rdf:resource="#Session"/>
  <rdfs:range rdf:resource="#Artifact"/>
</owl:ObjectProperty>

<owl:Class rdf:about="#Agent">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Human">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Session">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Artifact">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Edit">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Outcome">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#State">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Information">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#SuccessCriterion">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#ProductionMetric">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Workflow">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#PersistentState">
  <rdfs:subClassOf rdf:resource="#State"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#State"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#isOperatedOnBy"/>
          <owl:someValuesFrom rdf:resource="#Agent"/>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#isAccessedBy"/>
          <owl:someValuesFrom rdf:resource="#Human"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#PrivateInfo">
  <rdfs:subClassOf rdf:resource="#Information"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Information"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#accessibleTo"/>
          <owl:onClass rdf:resource="#Agent"/>
          <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:maxQualifiedCardinality>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#GroundedCriterion">
  <rdfs:subClassOf rdf:resource="#SuccessCriterion"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#SuccessCriterion"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#measuredBy"/>
          <owl:someValuesFrom rdf:resource="#ProductionMetric"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#ConsequentialOutcome">
  <rdfs:subClassOf rdf:resource="#Outcome"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Outcome"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#hasConsequence"/>
          <owl:someValuesFrom rdf:resource="#ProductionMetric"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#SatisfiesC1">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasState"/>
      <owl:someValuesFrom rdf:resource="#PersistentState"/>
    </owl:Restriction>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#SatisfiesC2">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#partOf"/>
      <owl:someValuesFrom>
        <owl:Class>
          <owl:intersectionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="#Workflow"/>
            <owl:Restriction>
              <owl:onProperty rdf:resource="#hasSession"/>
              <owl:someValuesFrom>
                <owl:Class>
                  <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="#Session"/>
                    <owl:Restriction>
                      <owl:onProperty rdf:resource="#dependsOn"/>
                      <owl:someValuesFrom rdf:resource="#Session"/>
                    </owl:Restriction>
                  </owl:intersectionOf>
                </owl:Class>
              </owl:someValuesFrom>
            </owl:Restriction>
          </owl:intersectionOf>
        </owl:Class>
      </owl:someValuesFrom>
    </owl:Restriction>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#SatisfiesC3">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasCriterion"/>
      <owl:someValuesFrom rdf:resource="#GroundedCriterion"/>
    </owl:Restriction>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#SatisfiesC4">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasArtifact"/>
      <owl:someValuesFrom>
        <owl:Class>
          <owl:intersectionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="#Artifact"/>
            <owl:Restriction>
              <owl:onProperty rdf:resource="#hasEdit"/>
              <owl:someValuesFrom>
                <owl:Class>
                  <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="#Edit"/>
                    <owl:Restriction>
                      <owl:onProperty rdf:resource="#basedOn"/>
                      <owl:someValuesFrom rdf:resource="#PrivateInfo"/>
                    </owl:Restriction>
                  </owl:intersectionOf>
                </owl:Class>
              </owl:someValuesFrom>
            </owl:Restriction>
          </owl:intersectionOf>
        </owl:Class>
      </owl:someValuesFrom>
    </owl:Restriction>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#SatisfiesC5">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <owl:equivalentClass>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#hasOutcome"/>
      <owl:someValuesFrom rdf:resource="#ConsequentialOutcome"/>
    </owl:Restriction>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#ValidOversight">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#SatisfiesC1"/>
        <rdf:Description rdf:about="#SatisfiesC2"/>
        <rdf:Description rdf:about="#SatisfiesC3"/>
        <rdf:Description rdf:about="#SatisfiesC4"/>
        <rdf:Description rdf:about="#SatisfiesC5"/>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#FullOversight">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <owl:equivalentClass rdf:resource="#ValidOversight"/>
</owl:Class>

<owl:Class rdf:about="#PartialOversight">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#InvalidOversight">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#OntoChatGPT_Control">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#SatisfiesC1"/>
        <rdf:Description rdf:about="#SatisfiesC3"/>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>


</rdf:RDF>
